PORT=4173
HOST=127.0.0.1
PUBLIC_ORIGIN=http://127.0.0.1:4173
# Production: managed PostgreSQL, TLS enabled with trusted CA; never disable verification.
DATABASE_URL=
ATTACHMENT_CONTAINER_URL=
DATA_DIR=.local
SMTP_URL=
MAIL_FROM=
# Alternative authenticated email webhook: {to,code,expiresInMinutes,purpose}
MAIL_WEBHOOK_URL=
MAIL_WEBHOOK_TOKEN=
# Server-side authenticated n8n chat bridge; never put credentials in public/config.js.
N8N_CHAT_URL=
N8N_CHAT_TOKEN=
N8N_CHAT_BASIC_AUTH=
# Local development only. Codes saved in .local/mailbox.json; never returned by API.
DEV_MAILBOX=false
